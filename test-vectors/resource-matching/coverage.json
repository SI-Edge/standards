      "spec": [
        {
          "doc": "SK-COM",
          "version": "0.1",
          "section": "A6",
          "tag": "C2"
        }
      ],
      "operation": "resource-covers",
      "input": {
        "right": "urn:x:a/b",
        "resource": "urn:x:a/b"
      },
      "expected": {
        "value": true
      },
      "status": "provisional",
      "open_issue": "#23",
      "note": "Equal strings. Provisional until the matching rule in PR #58 is merged."
    },
